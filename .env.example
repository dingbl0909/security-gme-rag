# ---------- 本地部署推荐配置 ----------
GME_RAG_PARSER_PROVIDER=dots_ocr
DOTS_OCR_BASE_URL=http://127.0.0.1:8030
DOTS_OCR_PARSE_PATH=/parse
DOTS_OCR_API_KEY=

GME_RAG_EMBEDDING_PROVIDER=local
GME_RAG_MEMORY_PROVIDER=sqlite
GME_RAG_VECTOR_STORE=sqlite

# ---------- 可选：GME / Milvus / Redis ----------
GME_API_KEY=
GME_BASE_URL=
GME_EMBEDDING_PATH=/embeddings
GME_MODEL=iic/gme-Qwen2-VL-7B-Instruct
GME_DIMENSIONS=1024

REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=security-gme-rag

MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=security_gme_rag_chunks

# ---------- 解析网关（services/dots_ocr_gateway）----------
DOTS_GATEWAY_BACKEND=heuristic
DOTS_GATEWAY_PORT=8030
DOTS_GATEWAY_API_KEY=
# DOTS_GATEWAY_BACKEND=vllm
# DOTS_VLLM_BASE_URL=http://127.0.0.1:8000
# DOTS_VLLM_MODEL=dots-mocr

RAG_API_PORT=8020
